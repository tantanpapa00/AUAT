# BBooster Environment Configuration
# Week 19: Docker化 + 배포 준비
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DB_USER=bbooster
DB_PASSWORD=your_secure_password_here
DB_NAME=bbooster
DB_PORT=5432

# Full DATABASE_URL (for local development without Docker)
# DATABASE_URL=postgresql://bbooster:password@localhost:5432/bbooster

# ============================================
# Application Configuration
# ============================================
APP_PORT=8000
BASE_URL=http://76.13.180.30:8000
FRONTEND_URL=http://76.13.180.30:8000

# TradingView webhook secret (for /tv endpoint authentication)
TV_SECRET=your_tv_secret_here

# E-STOP initial state (true = all orders blocked)
ESTOP_ENABLED=false

# ============================================
# Google OAuth Configuration
# ============================================
# 1. https://console.cloud.google.com 에서 OAuth 클라이언트 ID 생성
# 2. 승인된 리디렉션 URI에 추가:
#    - http://your-domain.com/api/auth/google/callback
#    - http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT 비밀키 (프로덕션에서는 반드시 변경!)
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# 관리자 이메일 목록 (쉼표로 구분)
# 이 이메일로 로그인하면 자동으로 관리자(admin) 권한 부여
ADMIN_EMAILS=admin@example.com,another-admin@example.com

# ============================================
# Exchange API Keys (Optional - can be set in UI)
# ============================================
# OKX
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=

# Binance
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Bybit
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Upbit
# UPBIT_ACCESS_KEY=
# UPBIT_SECRET_KEY=

# KIS (Korea Investment & Securities)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=

# ============================================
# ngrok (Optional - for external webhook access)
# ============================================
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here
#
# ngrok is included in docker-compose.yml by default.
# Open http://localhost:4040 to see your public URL.
# TradingView webhook URL will be: https://<random>.ngrok.io/tv
