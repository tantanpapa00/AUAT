# BBooster Docker Ignore
# Week 19: Docker化

# Environment files (secrets)
.env
.env.*
*.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# Virtual environments
venv/
env/
.venv/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Documentation (not needed in container)
docs/
*.md
!README.md

# Scripts (development only)
scripts/

# Desktop/Mobile apps (separate builds)
pc-app/
mobile-app/
site/
brand/

# Test files
tests/
test_*.py
*_test.py
pytest.ini
.pytest_cache/

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log
logs/

# Local database files
*.db
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp

# Docker compose override (local settings)
docker-compose.override.yml
