\b BBooster \uc774\uc6a9\uc57d\uad00\b0\par
\par
\b \uc81c1\uc870 (\ubaa9\uc801)\b0\par
\ubcf8 \uc57d\uad00\uc740 \ud050\ube0c\uc2dc\uc2a4\ud15c(\uc774\ud558 "\ud68c\uc0ac")\uc774 \uc81c\uacf5\ud558\ub294 BBooster \uc11c\ube44\uc2a4\uc758 \uc774\uc6a9 \uc870\uac74\uc744 \uaddc\uc815\ud569\ub2c8\ub2e4.\par
\par
\b \uc81c2\uc870 (\ubd88\ubc95 \ubcf5\uc81c \uae08\uc9c0)\b0\par
1. \ubcf8 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc758 \ubb34\ub2e8 \ubcf5\uc81c, \ubc30\ud3ec, \uc5ed\uacf5\ud559\uc744 \uae08\uc9c0\ud569\ub2c8\ub2e4.\par
2. \uc704\ubc18 \uc2dc \uad00\ub828 \ubc95\ub960\uc5d0 \ub530\ub77c \ubbfc\ud615\uc0ac\uc0c1 \ucc45\uc784\uc744 \uc9c8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\par
\par
\b \uc81c3\uc870 (API \ud0a4 \uad00\ub9ac \ucc45\uc784)\b0\par
1. \uc0ac\uc6a9\uc790\uac00 \ub4f1\ub85d\ud55c \uac70\ub798\uc18c/\uc99d\uad8c\uc0ac API \ud0a4\ub294 \uc0ac\uc6a9\uc790 \ubcf8\uc778\uc774 \uad00\ub9ac\ud569\ub2c8\ub2e4.\par
2. API \ud0a4 \uc720\ucd9c\ub85c \uc778\ud55c \uc190\uc2e4\uc740 \ud68c\uc0ac\uac00 \ucc45\uc784\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\par
3. API \ud0a4\ub294 \ubc18\ub4dc\uc2dc \ucd9c\uae08 \uad8c\ud55c\uc744 \uc81c\uc678\ud558\uace0 \uc0dd\uc131\ud558\uc2dc\uae30 \ubc14\ub78d\ub2c8\ub2e4.\par
\par
\b \uc81c4\uc870 (\ud22c\uc790 \ucc45\uc784)\b0\par
1. BBooster\ub97c \ud1b5\ud55c \ubaa8\ub4e0 \ud22c\uc790 \ud310\ub2e8\uacfc \uacb0\uacfc\ub294 \uc0ac\uc6a9\uc790 \ubcf8\uc778\uc758 \ucc45\uc784\uc785\ub2c8\ub2e4.\par
2. \uc790\ub3d9\ub9e4\ub9e4 \uae30\ub2a5 \uc0ac\uc6a9 \uc2dc \ubc1c\uc0dd\ud558\ub294 \uc190\uc2e4\uc5d0 \ub300\ud574 \ud68c\uc0ac\ub294 \ucc45\uc784\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\par
3. \uacfc\uac70 \uc218\uc775\ub960\uc774 \ubbf8\ub798 \uc218\uc775\uc744 \ubcf4\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\par
\par
\b \uc81c5\uc870 (\uc11c\ube44\uc2a4 \uc911\ub2e8)\b0\par
1. \uc2dc\uc2a4\ud15c \uc810\uac80, \uc7a5\uc560, \ucc9c\uc7ac\uc9c0\ubcc0 \ub4f1\uc73c\ub85c \uc11c\ube44\uc2a4\uac00 \uc911\ub2e8\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\par
2. \uc11c\ube44\uc2a4 \uc911\ub2e8\uc73c\ub85c \uc778\ud55c \ub9e4\ub9e4 \uc190\uc2e4\uc5d0 \ub300\ud574 \ud68c\uc0ac\ub294 \ucc45\uc784\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\par
\par
\b \uc81c6\uc870 (\uac1c\uc778\uc815\ubcf4)\b0\par
1. \ud68c\uc0ac\ub294 \uc11c\ube44\uc2a4 \uc81c\uacf5\uc744 \uc704\ud574 \ucd5c\uc18c\ud55c\uc758 \uac1c\uc778\uc815\ubcf4\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4.\par
2. \uc218\uc9d1\ub41c \uc815\ubcf4\ub294 \uc11c\ube44\uc2a4 \uc81c\uacf5 \ubaa9\uc801 \uc678\uc5d0 \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\par
\par
\b \uc81c7\uc870 (\ube44\ubc00\ubc88\ud638 \uc815\ucc45)\b0\par
1. \ube44\ubc00\ubc88\ud638\ub294 12\uc790\ub9ac \uc774\uc0c1, \uc601\ubb38\uc790/\uc22b\uc790/\ud2b9\uc218\ubb38\uc790\ub97c \ud3ec\ud568\ud574\uc57c \ud569\ub2c8\ub2e4.\par
2. \uacc4\uc815 \ubcf4\uc548\uc744 \uc704\ud574 \uc8fc\uae30\uc801\uc778 \ube44\ubc00\ubc88\ud638 \ubcc0\uacbd\uc744 \uad8c\uc7a5\ud569\ub2c8\ub2e4.\par
\par
\ubcf8 \uc57d\uad00\uc5d0 \ub3d9\uc758\ud558\uc9c0 \uc54a\uc73c\uba74 BBooster\ub97c \uc124\uce58 \ubc0f \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\par
