{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm --prefix ui run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../ui/dist"
  },
  "package": {
    "productName": "BBooster",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      },
      "process": {
        "all": true,
        "exit": true,
        "relaunch": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "unminimize": true,
        "setFocus": true
      },
      "path": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/*", "$APPDATA/**", "$HOME/*"]
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://127.0.0.1:8000/*",
          "http://localhost:8000/*",
          "http://76.13.180.30/*",
          "https://76.13.180.30/*",
          "https://qube-system.com/*",
          "https://*.qube-system.com/*"
        ]
      }
    },
    "bundle": {
      "active": true,
      "category": "Finance",
      "copyright": "Copyright 2026 큐브시스템 (QUBE System)",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/256x256.png",
        "icons/icon.ico"
      ],
      "identifier": "com.qubesystem.bbooster",
      "longDescription": "BBooster - TradingView webhook to exchange auto-trading tool",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "BBooster Auto Trading",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "wix": null,
        "nsis": {
          "installerIcon": "icons/icon.ico",
          "installMode": "currentUser",
          "languages": ["English", "Korean"],
          "displayLanguageSelector": false,
          "license": "LICENSE_KO.rtf"
        }
      }
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "BBooster — 큐브시스템",
        "width": 1200,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ]
  }
}
