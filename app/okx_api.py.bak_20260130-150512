import os
import json
import base64
import hmac
import hashlib
from datetime import datetime, timezone
from urllib import request as urlreq
from urllib.error import HTTPError, URLError

def _okx_ts() -> str:
    # OKX header timestamp (ISO8601, ms, Z)
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")

def _b64_hmac_sha256(secret: str, msg: str) -> str:
    mac = hmac.new(secret.encode("utf-8"), msg.encode("utf-8"), hashlib.sha256).digest()
    return base64.b64encode(mac).decode("utf-8")

def _okx_request(method: str, path: str, body: dict | None = None) -> dict:
    base_url = os.getenv("OKX_BASE_URL", "https://www.okx.com").rstrip("/")
    api_key = os.getenv("OKX_API_KEY", "").strip()
    api_secret = os.getenv("OKX_API_SECRET", "").strip()
    passphrase = os.getenv("OKX_API_PASSPHRASE", "").strip()

    if not api_key or not api_secret or not passphrase:
        raise RuntimeError("missing OKX_API_KEY/OKX_API_SECRET/OKX_API_PASSPHRASE")

    simulated = os.getenv("OKX_SIMULATED", "0").strip()  # "1"이면 demo trading (헤더)
    timeout = float(os.getenv("OKX_TIMEOUT", "10"))

    method_u = method.upper()
    body_str = "" if body is None else json.dumps(body, separators=(",", ":"), ensure_ascii=False)
    ts = _okx_ts()

    prehash = f"{ts}{method_u}{path}{body_str}"
    sign = _b64_hmac_sha256(api_secret, prehash)

    url = f"{base_url}{path}"
    data = None if body is None else body_str.encode("utf-8")

    req = urlreq.Request(url, data=data, method=method_u)
    req.add_header("Content-Type", "application/json")
    req.add_header("OK-ACCESS-KEY", api_key)
    req.add_header("OK-ACCESS-SIGN", sign)
    req.add_header("OK-ACCESS-TIMESTAMP", ts)
    req.add_header("OK-ACCESS-PASSPHRASE", passphrase)
    # demo/simulated trading header
    req.add_header("x-simulated-trading", "1" if simulated == "1" else "0")

    try:
        with urlreq.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except Exception:
                return {"code": "http_non_json", "msg": raw}
    except HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"okx_http_error status={e.code} body={raw}")
    except URLError as e:
        raise RuntimeError(f"okx_network_error {e}")

def okx_place_order(*, symbol: str, side: str, qty: float, order_type: str = "market", price: float | None = None, tgt_ccy: str = "base_ccy") -> dict:
    """
    OKX Spot 주문 (v5 /api/v5/trade/order)
    - tdMode: cash (스팟)
    - ordType: market / limit
    - sz: qty (tgtCcy로 base/quote 지정 가능; 기본 base_ccy)
    """
    if not symbol or "-" not in symbol:
        raise RuntimeError(f"bad_symbol: {symbol}")
    side = (side or "").lower().strip()
    if side not in ("buy", "sell"):
        raise RuntimeError(f"bad_side: {side}")
    ord_type = (order_type or "market").lower().strip()
    if ord_type not in ("market", "limit"):
        raise RuntimeError(f"bad_order_type: {ord_type}")

    if qty is None or float(qty) <= 0:
        raise RuntimeError(f"bad_qty: {qty}")

    body = {
        "instId": symbol,
        "tdMode": "cash",
        "side": side,
        "ordType": ord_type,
        "sz": str(qty),
    }

    # SPOT market에서 sz 단위(base/quote) 선택
    if ord_type == "market":
        body["tgtCcy"] = tgt_ccy  # base_ccy / quote_ccy
    else:
        if price is None or float(price) <= 0:
            raise RuntimeError("limit_requires_price(px)")
        body["px"] = str(price)

    res = _okx_request("POST", "/api/v5/trade/order", body)

    # OKX 공통 응답: code="0" 성공, data[0].ordId
    code = str(res.get("code", ""))
    if code != "0":
        raise RuntimeError(f"okx_error code={code} msg={res.get('msg')} data={res.get('data')}")

    data = res.get("data") or []
    first = data[0] if isinstance(data, list) and data else {}
    ord_id = first.get("ordId") or first.get("orderId")

    # main.py에서 okx_order_id 파싱하기 쉽게 평탄화
    out = dict(first) if isinstance(first, dict) else {"data0": first}
    out["ordId"] = ord_id
    out["_raw"] = res
    return out
