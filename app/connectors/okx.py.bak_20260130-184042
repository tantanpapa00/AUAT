from __future__ import annotations

import os
import json
import base64
import hmac
import hashlib
from datetime import datetime, timezone
from urllib import request as urlreq
from urllib.error import HTTPError, URLError

# Week5 v1 OKX connector: dependency-free (urllib), matches main.py expectations (code/data list response).
# NOTE: Spot only (tdMode=cash). Futures/perp is out of scope here.


def _okx_ts() -> str:
    # OKX header timestamp (ISO8601, ms, Z)
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def _b64_hmac_sha256(secret: str, msg: str) -> str:
    mac = hmac.new(secret.encode("utf-8"), msg.encode("utf-8"), hashlib.sha256).digest()
    return base64.b64encode(mac).decode("utf-8")


def _okx_env() -> tuple[str, str, str, str, str, float]:
    base_url = os.getenv("OKX_BASE_URL", "https://www.okx.com").rstrip("/")
    api_key = os.getenv("OKX_API_KEY", "").strip()
    api_secret = os.getenv("OKX_API_SECRET", "").strip()
    passphrase = os.getenv("OKX_API_PASSPHRASE", "").strip()
    simulated = os.getenv("OKX_SIMULATED", "0").strip()  # "1"이면 demo trading
    timeout = float(os.getenv("OKX_TIMEOUT", "10"))
    if not api_key or not api_secret or not passphrase:
        raise RuntimeError("missing OKX_API_KEY/OKX_API_SECRET/OKX_API_PASSPHRASE")
    return base_url, api_key, api_secret, passphrase, simulated, timeout


def _okx_request(method: str, path: str, query: str = "", body: dict | None = None) -> dict:
    base_url, api_key, api_secret, passphrase, simulated, timeout = _okx_env()

    method_u = method.upper()
    body_str = "" if body is None else json.dumps(body, separators=(",", ":"), ensure_ascii=False)
    ts = _okx_ts()

    if query:
        prehash = f"{ts}{method_u}{path}?{query}{body_str}"
        url = f"{base_url}{path}?{query}"
    else:
        prehash = f"{ts}{method_u}{path}{body_str}"
        url = f"{base_url}{path}"

    sign = _b64_hmac_sha256(api_secret, prehash)

    data = None if body is None else body_str.encode("utf-8")
    req = urlreq.Request(url, data=data, method=method_u)
    req.add_header("Content-Type", "application/json")
    # Some environments get 403 (OKX edge) without a browser-like User-Agent.
    ua = os.getenv("OKX_USER_AGENT", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36")
    req.add_header("User-Agent", ua)
    req.add_header("OK-ACCESS-KEY", api_key)
    req.add_header("OK-ACCESS-SIGN", sign)
    req.add_header("OK-ACCESS-TIMESTAMP", ts)
    req.add_header("OK-ACCESS-PASSPHRASE", passphrase)
    # demo/simulated trading header
    req.add_header("x-simulated-trading", "1" if simulated == "1" else "0")

    try:
        with urlreq.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw)
            except Exception:
                return {"code": "http_non_json", "msg": raw}
    except HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"okx_http_error status={e.code} body={raw}")
    except URLError as e:
        raise RuntimeError(f"okx_network_error {e}")


def okx_place_order(*, symbol: str, side: str, qty: float, order_type: str = "market",
                    px: float | None = None, payload: dict | None = None) -> dict:
    """Place OKX spot order (returns OKX raw response dict with code/data list)."""
    if not symbol or "-" not in symbol:
        raise RuntimeError(f"bad_symbol: {symbol}")

    side_l = (side or "").lower().strip()
    if side_l not in ("buy", "sell"):
        raise RuntimeError(f"bad_side: {side}")

    ord_type = (order_type or "market").lower().strip()
    if ord_type not in ("market", "limit"):
        ord_type = "market"

    q = float(qty)
    if q <= 0:
        raise RuntimeError(f"bad_qty: {qty}")

    body: dict = {
        "instId": symbol,
        "tdMode": "cash",
        "side": side_l,
        "ordType": ord_type,
        "sz": str(q),
    }

    # IMPORTANT: OKX spot market BUY defaults can interpret `sz` as quote currency.
    # Our bot's `qty` is base size, so force base sizing for market orders.
    if ord_type == "market":
        body["tgtCcy"] = "base_ccy"

    if ord_type == "limit":
        if px is None or float(px) <= 0:
            raise RuntimeError("limit_requires_price(px)")
        body["px"] = str(float(px))

    # allow caller to force client order id for recover
    if isinstance(payload, dict) and payload.get("clOrdId"):
        body["clOrdId"] = str(payload.get("clOrdId"))

    # NOTE: for spot market orders, OKX supports tgtCcy; keep default OKX behavior (base_ccy).
    # If you need quote_ccy sizing, extend later in Week5.
    res = _okx_request("POST", "/api/v5/trade/order", body=body)

    code = str(res.get("code", ""))
    if code != "0":
        raise RuntimeError(f"okx_error code={code} msg={res.get('msg')} data={res.get('data')}")
    return res


def okx_get_order(*, symbol: str, okx_order_id: str | None = None, okx_clord_id: str | None = None) -> dict:
    """Get OKX order by ordId or clOrdId (returns OKX raw response dict with code/data list)."""
    if not symbol:
        raise RuntimeError("missing_symbol")
    if okx_order_id:
        query = f"instId={symbol}&ordId={okx_order_id}"
    elif okx_clord_id:
        query = f"instId={symbol}&clOrdId={okx_clord_id}"
    else:
        raise RuntimeError("missing_ordId_or_clOrdId")

    res = _okx_request("GET", "/api/v5/trade/order", query=query)

    code = str(res.get("code", ""))
    if code != "0":
        raise RuntimeError(f"okx_error code={code} msg={res.get('msg')} data={res.get('data')}")
    return res


class OKXConnector:
    name = "OKX"

    def place_order(self, *, symbol: str, side: str, qty: float, order_type: str = "market",
                    px: float | None = None, payload: dict | None = None) -> dict:
        return okx_place_order(symbol=symbol, side=side, qty=qty, order_type=order_type, px=px, payload=payload)

    def get_order(self, *, symbol: str, okx_order_id: str | None = None, okx_clord_id: str | None = None) -> dict:
        return okx_get_order(symbol=symbol, okx_order_id=okx_order_id, okx_clord_id=okx_clord_id)
