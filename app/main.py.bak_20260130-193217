# ---- OKX broker (only if missing) ----
if "okx_place_order" not in globals():
    import json as _json
    import time as _time
    import base64 as _base64
    import hmac as _hmac
    from datetime import datetime as _dt

    try:
        import requests as _requests
    except Exception as _e:
        _requests = None

    def _okx_env():
        # supports both OKX_API_* and legacy OKX_* names
        def _clean(v: str) -> str:
            v2 = (v or "").strip()
            if len(v2) >= 2 and ((v2[0] == v2[-1]) and v2[0] in ("\"", "\'")):
                v2 = v2[1:-1].strip()
            return v2
        base = _clean(os.getenv("OKX_BASE_URL") or "https://www.okx.com").rstrip("/")
        key  = _clean(os.getenv("OKX_API_KEY") or os.getenv("OKX_KEY") or "")
        sec  = _clean(os.getenv("OKX_API_SECRET") or os.getenv("OKX_SECRET") or "")
        pas  = _clean(os.getenv("OKX_API_PASSPHRASE") or os.getenv("OKX_PASSPHRASE") or "")
        sim  = _clean(os.getenv("OKX_SIMULATED") or "0")
        timeout = float(_clean(os.getenv("OKX_TIMEOUT") or "10") or "10")
        # treat whitespace/quoted blanks as missing
        if not key or not sec or not pas:
            raise RuntimeError("okx_env_missing: need OKX_API_KEY/OKX_API_SECRET/OKX_API_PASSPHRASE (or OKX_KEY/OKX_SECRET/OKX_PASSPHRASE)")
        return base, key, sec, pas, sim, timeout

    def _okx_ts() -> str:
        return _dt.utcnow().isoformat(timespec="milliseconds") + "Z"

    def _okx_sign(secret: str, prehash: str) -> str:
        mac = _hmac.new(secret.encode("utf-8"), prehash.encode("utf-8"), digestmod="sha256").digest()
        return _base64.b64encode(mac).decode("utf-8")

    def _okx_headers(ts: str, sign: str, *, key: str, pas: str, sim: str):
        headers = {
            "Content-Type": "application/json",
            "OK-ACCESS-KEY": key,
            "OK-ACCESS-SIGN": sign,
            "OK-ACCESS-TIMESTAMP": ts,
            "OK-ACCESS-PASSPHRASE": pas,
        }
        if sim == "1":
            headers["x-simulated-trading"] = "1"
        return headers


    def _dec_str(x) -> str:
        """Return a non-scientific string for numbers."""
        try:
            from decimal import Decimal
            if isinstance(x, Decimal):
                d = x
            else:
                d = Decimal(str(x))
            s = format(d, "f")
            if "." in s:
                s = s.rstrip("0").rstrip(".")
            return s if s else "0"
        except Exception:
            try:
                return str(float(x))
            except Exception:
                return str(x)

    def _okx_place_order_requests_v1(*, symbol: str, side: str, qty: float, order_type: str = "market", payload: dict | None = None) -> dict:
        """Place OKX spot order. Returns OKX JSON (code=0)."""
        if _requests is None:
            raise RuntimeError("requests_missing")
        base, key, sec, pas, sim, timeout = _okx_env()
        path = "/api/v5/trade/order"
        url = base.rstrip("/") + path

        ord_type = (order_type or "market").lower()
        if ord_type not in ("market", "limit"):
            ord_type = "market"

        s_side = (side or "").lower()
        if s_side not in ("buy", "sell"):
            raise RuntimeError("bad_side")

        body = {
            "instId": symbol,
            "tdMode": "cash",
            "side": s_side,
            "ordType": ord_type,
            "sz": _dec_str(qty),
        }

        if isinstance(payload, dict):
            clid = payload.get("clOrdId") or payload.get("clordid") or payload.get("client_oid") or payload.get("clientOrderId")
            if clid:
                body["clOrdId"] = str(clid)

        if s_side == "buy" and ord_type == "market":
            body["tgtCcy"] = "base_ccy"

        if ord_type == "limit":
            px = None
            if isinstance(payload, dict):
                px = payload.get("price") or payload.get("px")
            if px is None:
                raise RuntimeError("limit_requires_price")
            body["px"] = _dec_str(px)

        body_json = _json.dumps(body, separators=(",", ":"), ensure_ascii=False)
        ts = _okx_ts()
        prehash = f"{ts}POST{path}{body_json}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        resp = _requests.post(url, headers=headers, data=body_json.encode("utf-8"), timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")
        data = resp.json()
        if str(data.get("code")) != "0":
            raise RuntimeError(f"okx_error code={data.get('code')} msg={data.get('msg')} data={data.get('data')}")
        return data

    def okx_get_order(*, symbol: str, okx_order_id: str | None = None, okx_clord_id: str | None = None) -> dict:
        """Fetch OKX order by ordId or clOrdId."""
        if _requests is None:
            raise RuntimeError("requests_missing")
        base, key, sec, pas, sim, timeout = _okx_env()
        path = "/api/v5/trade/order"

        if okx_order_id:
            query = f"instId={symbol}&ordId={okx_order_id}"
        elif okx_clord_id:
            query = f"instId={symbol}&clOrdId={okx_clord_id}"
        else:
            raise RuntimeError("missing_ordId_or_clOrdId")

        url = base.rstrip("/") + path + "?" + query
        ts = _okx_ts()
        prehash = f"{ts}GET{path}?{query}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        resp = _requests.get(url, headers=headers, timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")
        data = resp.json()
        if str(data.get("code")) != "0":
            raise RuntimeError(f"okx_error code={data.get('code')} msg={data.get('msg')} data={data.get('data')}")
        return data

        return headers

# ============================================================
# [HOTPATCH_W3D1_OKX_PREFLIGHT] block submit on OKX env mismatch (50101)
# - cache preflight result (TTL seconds)
# - wrap okx_place_order to enforce preflight before sending
# - reason code: OKX_ENV_MISMATCH / OKX_AUTH_ERROR
# ============================================================

if "_okx_preflight_cache" not in globals():
    _okx_preflight_cache = {"ts": 0.0, "ok": None, "msg": ""}

def okx_preflight(*, ttl_sec: int = 30) -> dict:
    """Check OKX environment/auth quickly. Returns {ok:bool, msg:str} with TTL cache."""
    import time
    now = time.time()
    try:
        if _okx_preflight_cache["ok"] is not None and (now - float(_okx_preflight_cache["ts"])) < ttl_sec:
            return {"ok": bool(_okx_preflight_cache["ok"]), "msg": str(_okx_preflight_cache["msg"])}

        # minimal call that triggers 50101 if environment mismatch
        base, key, sec, pas, sim, timeout = _okx_env()
        path = "/api/v5/account/balance"
        url = base + path

        ts = _okx_ts()
        prehash = f"{ts}GET{path}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        if _requests is None:
            raise RuntimeError("requests_missing")

        resp = _requests.get(url, headers=headers, timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")

        data = resp.json()
        if str(data.get("code")) != "0":
            raise RuntimeError(f"okx_error code={data.get('code')} msg={data.get('msg')} data={data.get('data')}")

        _okx_preflight_cache.update({"ts": now, "ok": True, "msg": "ok"})
        return {"ok": True, "msg": "ok"}

    except Exception as e:
        msg = str(e)
        _okx_preflight_cache.update({"ts": now, "ok": False, "msg": msg})
        return {"ok": False, "msg": msg}

# wrap okx_place_order (enforce preflight)
if "okx_place_order" in globals() and "_okx_place_order_wrapped" not in globals():
    _okx_place_order_wrapped = True
    _okx_place_order_original = okx_place_order

    def _okx_place_order_preflight_wrap_v1(*, symbol: str, side: str, qty: float, order_type: str = "market", payload: dict | None = None) -> dict:
        chk = okx_preflight(ttl_sec=int(os.getenv("OKX_PREFLIGHT_TTL", "30") or "30"))
        if not chk.get("ok", False):
            # normalize reason for 50101
            msg = str(chk.get("msg", ""))
            if "50101" in msg or "environment" in msg.lower():
                raise RuntimeError("OKX_ENV_MISMATCH: " + msg)
            raise RuntimeError("OKX_AUTH_ERROR: " + msg)
        return _okx_place_order_original(symbol=symbol, side=side, qty=qty, order_type=order_type, payload=payload)

