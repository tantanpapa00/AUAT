                """), {"id": oid, "r": rmsg, "ss": ss, "attempt": attempt, "delay": delay})
                db.commit()
                out_items.append({"id": oid, "status": "failed", "submit_status": ss, "reason": rmsg, "attempt": attempt, "next_submit_in_sec": delay})

        return {
            "ok": True,
            "count": len(out_items),
            "items": out_items,
            "scanned": scanned,
            "note": "send_checked",
            "elapsed_ms": int((_time.time() - t0) * 1000),
