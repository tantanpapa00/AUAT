            url = base + path
            ts = _okx_ts()
            prehash = f"{ts}GET{path}"
            sign = _okx_sign(sec, prehash)
            headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

            resp = _requests.get(url, headers=headers, timeout=timeout)
            if resp.status_code != 200:
                raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")
            j = resp.json()
            if str(j.get("code")) != "0":
                raise RuntimeError(f"okx_error code={j.get('code')} msg={j.get('msg')} data={j.get('data')}")

            _okx_bal_cache2.update({"ts": now, "data": j, "msg": "ok"})
            return {"ok": True, "data": j, "msg": "ok"}
        except Exception as e:
            _okx_bal_cache2.update({"ts": now, "data": None, "msg": str(e)})
            return {"ok": False, "data": None, "msg": str(e)}

    def okx_avail_ccy2(ccy: str) -> float:
        res = okx_get_balances2(ttl_sec=int(os.getenv("OKX_BAL_TTL", "10") or "10"))
        if not res.get("ok"):
            return 0.0
        j = res.get("data") or {}
        try:
            data = (j.get("data") or [])
            if not data: return 0.0
            details = (data[0].get("details") or [])
            ccy_u = (ccy or "").upper()
            for d in details:
                if (d.get("ccy") or "").upper() == ccy_u:
                    return float(d.get("availBal") or 0.0)
        except Exception:
            pass
        return 0.0


    # === [HOTPATCH_W3D3_OKX_BAL_SPLIT] trading vs funding balance ===
    # OKX는 계정 구조(Trading vs Funding)에 따라 /account/balance(트레이딩)와 /asset/balances(펀딩)가 분리되어 보일 수 있습니다.
    # 사용자가 "USDT가 있는데 bot은 0으로 본다" 케이스를 명확히 하기 위해 두 소스를 함께 조회/표시합니다.

    if "_okx_asset_bal_cache2" not in globals():
        _okx_asset_bal_cache2 = {"ts": 0.0, "data": None, "msg": ""}

    def okx_get_asset_balances2(*, ccy: str | None = None, ttl_sec: int = 10) -> dict:
        """Funding(Asset) balances via /api/v5/asset/balances (TTL cache)."""
        import time
        now = time.time()
        try:
            if _okx_asset_bal_cache2["data"] is not None and (now - float(_okx_asset_bal_cache2["ts"])) < ttl_sec:
                return {"ok": True, "data": _okx_asset_bal_cache2["data"], "msg": "cached"}

            base, key, sec, pas, sim, timeout = _okx_env()
            q = ""
            if ccy:
                q = f"?ccy={str(ccy).upper()}"
            path = "/api/v5/asset/balances" + q
            url = base + path
            ts = _okx_ts()
            prehash = f"{ts}GET{path}"
            sign = _okx_sign(sec, prehash)
            headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

            resp = _requests.get(url, headers=headers, timeout=timeout)
            if resp.status_code != 200:
                raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")
            j = resp.json()
            if str(j.get("code")) != "0":
                raise RuntimeError(f"okx_error code={j.get('code')} msg={j.get('msg')} data={j.get('data')}")

            _okx_asset_bal_cache2.update({"ts": now, "data": j, "msg": "ok"})
            return {"ok": True, "data": j, "msg": "ok"}
        except Exception as e:
            _okx_asset_bal_cache2.update({"ts": now, "data": None, "msg": str(e)})
            return {"ok": False, "data": None, "msg": str(e)}

    def _okx_asset_avail(j: dict, ccy: str) -> float:
        """Parse available balance from /asset/balances payload."""
        try:
            data = (j.get("data") or [])
            if not data:
                return 0.0
            ccy_u = (ccy or "").upper()
            for d in data:
                if (d.get("ccy") or "").upper() == ccy_u:
                    # OKX asset/balances uses 'availBal' and/or 'bal'
                    v = d.get("availBal")
                    if v is None or str(v).strip() == "":
                        v = d.get("bal")
                    return float(v or 0.0)
        except Exception:
            pass
        return 0.0

    def okx_avail_ccy_split2(ccy: str) -> dict:
        """Return trading/funding/total available."""
        ccy_u = (ccy or "").upper()
        trading = 0.0
        funding = 0.0

        r1 = okx_get_balances2(ttl_sec=int(os.getenv("OKX_BAL_TTL", "10") or "10"))
        if r1.get("ok"):
            j1 = r1.get("data") or {}
            try:
                data = (j1.get("data") or [])
                if data:
                    details = (data[0].get("details") or [])
                    for d in details:
                        if (d.get("ccy") or "").upper() == ccy_u:
                            trading = float(d.get("availBal") or 0.0)
                            break
            except Exception:
                pass

        r2 = okx_get_asset_balances2(ccy=ccy_u, ttl_sec=int(os.getenv("OKX_BAL_TTL", "10") or "10"))
        if r2.get("ok"):
            j2 = r2.get("data") or {}
            funding = _okx_asset_avail(j2, ccy_u)

        return {"ccy": ccy_u, "trading": trading, "funding": funding, "total": trading + funding,
                "src": {"trading_ok": bool(r1.get("ok")), "funding_ok": bool(r2.get("ok"))},
                "src_msg": {"trading": str(r1.get("msg") or ""), "funding": str(r2.get("msg") or "")}}

    # Override: keep existing callers working (returns TRADING avail, because 주문은 트레이딩 계정 기준)
    def okx_avail_ccy2(ccy: str) -> float:
        return float(okx_avail_ccy_split2(ccy).get("trading") or 0.0)

    # Diag: show split balances (USDT + optional ccy)
    try:
        if "app" in globals() and "_okx_diag_balance_split2" not in globals():
            _okx_diag_balance_split2 = True

            @app.get("/api/diag/okx-balance")
            @app.get("/api/diag/okx-balance-split")
            def diag_okx_balance_split(ccy: str = "USDT"):
                out = okx_avail_ccy_split2(ccy)
                out_usdt = okx_avail_ccy_split2("USDT")
                return {"ok": True, "ccy": out, "usdt": out_usdt}
    except Exception:
        pass


    def okx_last_price2(instId: str, *, ttl_sec: int = 10) -> float | None:
        import time
        now = time.time()
        k = (instId or "").strip()
        if not k: return None
        try:
            hit = _okx_px_cache2.get(k)
            if hit and (now - float(hit.get("ts", 0.0))) < ttl_sec:
                return float(hit.get("px"))

            base = os.getenv("OKX_BASE_URL") or "https://www.okx.com"
            url = f"{base}/api/v5/market/ticker?instId={k}"
            resp = _requests.get(url, timeout=float(os.getenv("OKX_TIMEOUT", "10") or "10"))
            if resp.status_code != 200: return None
            j = resp.json()
            if str(j.get("code")) != "0": return None
            data = j.get("data") or []
            if not data: return None
            px = float(data[0].get("last") or 0.0)
            if px <= 0: return None
            _okx_px_cache2[k] = {"ts": now, "px": px}
            return px
        except Exception:
            return None

    def _inst_base_quote2(instId: str) -> tuple[str, str]:
        s = (instId or "")
        if "-" in s:
            a, b = s.split("-", 1)
            return (a.upper(), b.upper())
        return (s.upper(), "USDT")

    def okx_balance_guard2(*, symbol: str, side: str, qty: float) -> None:
        if not _ps_bool(os.getenv("OKX_BAL_GUARD_ENABLE", "1"), True):
            return

        side_l = (side or "").lower()
        base_ccy, quote_ccy = _inst_base_quote2(symbol)

        if side_l == "sell":
            sp = okx_avail_ccy_split2(base_ccy)
            if (not (sp.get("src") or {}).get("trading_ok")) and (not (sp.get("src") or {}).get("funding_ok")):
                m = sp.get("src_msg") or {}
                raise RuntimeError(f"BALANCE_FETCH_FAILED: cannot read OKX balances for {base_ccy}. trading_err={m.get('trading','')} funding_err={m.get('funding','')}")
            have_t = float(sp.get("trading") or 0.0)
            have_f = float(sp.get("funding") or 0.0)
            if have_t + 1e-12 < float(qty):
                # 사용자 잔고(펀딩)에 있는데 트레이딩이 0인 케이스를 명확히 안내
                if have_f + 1e-12 >= float(qty):
                    raise RuntimeError(f"INSUFFICIENT_TRADING_BAL: need {qty} {base_ccy}, trading {have_t} {base_ccy}, funding {have_f} {base_ccy} (transfer funding->trading)")
                raise RuntimeError(f"INSUFFICIENT_BAL: need {qty} {base_ccy}, have {have_t} {base_ccy}")
            return

        px = okx_last_price2(symbol, ttl_sec=int(os.getenv("OKX_PX_TTL", "10") or "10"))
        if px is None:
            if _ps_bool(os.getenv("OKX_BLOCK_ON_NO_PRICE", "1"), True):
                raise RuntimeError("PRICE_UNAVAILABLE: cannot estimate required quote amount")
            return

        slip = _ps_float(os.getenv("OKX_BAL_GUARD_SLIPPAGE", "0.01"), 0.01)
        need_quote = float(qty) * float(px) * (1.0 + slip)
        have_sp = okx_avail_ccy_split2(quote_ccy)
        if (not (have_sp.get("src") or {}).get("trading_ok")) and (not (have_sp.get("src") or {}).get("funding_ok")):
            m = have_sp.get("src_msg") or {}
            raise RuntimeError(f"BALANCE_FETCH_FAILED: cannot read OKX balances for {quote_ccy}. trading_err={m.get('trading','')} funding_err={m.get('funding','')}")
        have_quote_t = float(have_sp.get("trading") or 0.0)
        have_quote_f = float(have_sp.get("funding") or 0.0)
        if have_quote_t + 1e-8 < need_quote:
            if have_quote_f + 1e-8 >= need_quote:
                raise RuntimeError(f"INSUFFICIENT_TRADING_BAL: need~{need_quote:.6f} {quote_ccy} (qty={qty} px={px}), trading {have_quote_t} {quote_ccy}, funding {have_quote_f} {quote_ccy} (transfer funding->trading)")
            raise RuntimeError(f"INSUFFICIENT_BAL: need~{need_quote:.6f} {quote_ccy} (qty={qty} px={px}), have {have_quote_t} {quote_ccy}")

    # Wrap okx_place_order so any submit path is guarded
    if "okx_place_order" in globals() and "_okx_place_order_bal_guard2_wrapped" not in globals():
        _okx_place_order_bal_guard2_wrapped = True
        _okx_place_order_before_guard2 = okx_place_order

        def _okx_place_order_bal_guard2_wrap_v1(*, symbol: str | None = None, side: str | None = None, qty: float | None = None, order_type: str = "market", payload: dict | None = None, **kwargs) -> dict:
            # compat: accept legacy kwargs (instId/ordType/sz/tdMode) without breaking
            if symbol is None and "instId" in kwargs:
                symbol = kwargs.get("instId")
            if side is None and "side" in kwargs:
                side = kwargs.get("side")
            if qty is None:
                if "qty" in kwargs:
                    qty = float(kwargs.get("qty"))
                elif "sz" in kwargs:
                    qty = float(kwargs.get("sz"))
            if (not order_type or str(order_type).strip() == "") and "ordType" in kwargs:
                order_type = str(kwargs.get("ordType") or "market")
            if symbol is None or side is None or qty is None:
                raise ValueError(f"missing_required: symbol/side/qty (symbol={symbol}, side={side}, qty={qty})")
            qty_f = float(qty)
            okx_balance_guard2(symbol=symbol, side=side, qty=qty_f)
            return _okx_place_order_before_guard2(symbol=symbol, side=side, qty=qty_f, order_type=(order_type or "market"), payload=payload)

    # Ensure diag route exists
    try:
        if "app" in globals():
            @app.get("/api/diag/okx-balance-legacy")
            def diag_okx_balance():
                return {"ok": True, "avail": {"USDT": okx_avail_ccy2("USDT")}}
    except Exception:
        pass


