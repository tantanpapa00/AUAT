                            if isinstance(data0, list) and data0 and isinstance(data0[0], dict):
                                _ord = data0[0].get("ordId")
                                if _ord:
                                    _od = data0[0]
                                    _state = str(_od.get("state") or "sent")
                                    _stl = _state.lower()
