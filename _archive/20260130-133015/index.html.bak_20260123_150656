<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>AutoBot Admin</title>
  <style>
    :root{
      --bg:#0b1220;
      --card:#111a2e;
      --card2:#0f172a;
      --line:#22304a;
      --text:#e5e7eb;
      --muted:#9ca3af;
      --pri:#60a5fa;
      --pri2:#93c5fd;
      --ok:#34d399;
      --warn:#fbbf24;
      --bad:#f87171;
      --w: #fb923c;
      --shadow: 0 10px 30px rgba(0,0,0,.35);
      --radius:16px;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      --sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", Arial, sans-serif;
    }
    *{ box-sizing:border-box; }
    body{
      margin:0;
      font-family:var(--sans);
      background: radial-gradient(1200px 600px at 20% 0%, rgba(96,165,250,.16), transparent 60%),
                  radial-gradient(1200px 600px at 80% 0%, rgba(52,211,153,.12), transparent 60%),
                  var(--bg);
      color:var(--text);
    }
    header{
      padding:20px 24px;
      border-bottom:1px solid var(--line);
      background: rgba(17,26,46,.65);
      backdrop-filter: blur(10px);
      position: sticky; top:0; z-index: 20;
    }
    header .top{
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      max-width:1200px; margin:0 auto;
    }
    h1{ margin:0; font-size:18px; font-weight:800; letter-spacing:.2px; }
    .sub{ color:var(--muted); font-size:12px; margin-top:2px; }
    .wrap{ max-width:1200px; margin:0 auto; padding:18px 24px 60px; }
    .tabs{ display:flex; gap:10px; margin:16px 0 14px; flex-wrap:wrap; }
    .tab{
      padding:10px 14px; border-radius:999px;
      border:1px solid var(--line);
      background: rgba(15,23,42,.6);
      cursor:pointer; font-weight:700; font-size:13px;
      color:var(--muted);
      transition:.15s;
      display:flex; align-items:center; gap:8px;
    }
    .tab.active{
      background: rgba(96,165,250,.16);
      border-color: rgba(96,165,250,.35);
      color: var(--text);
    }
    .pill{ display:inline-block; padding:2px 8px; border-radius:999px; border:1px solid var(--line); font-size:12px; }
    .pill.on{ background:#0f2a20; border-color:#1f8f64; color:var(--ok); }
    .pill.off{ background:#2a1a0f; border-color:#a16207; color:var(--warn); }
    .grid2{ display:grid; grid-template-columns: 1.2fr .8fr; gap:14px; align-items:start; }
    @media (max-width: 980px){ .grid2{ grid-template-columns: 1fr; } }
    .card{
      background: rgba(17,26,46,.75);
      border:1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .card .hd{
      padding:14px 14px 10px;
      border-bottom:1px solid var(--line);
      display:flex; align-items:center; justify-content:space-between; gap:10px;
    }
    .card .hd b{ font-size:13px; }
    .card .bd{ padding:14px; }
    .hint{ color:var(--muted); font-size:12px; line-height:1.45; }
    .mono{ font-family: var(--mono); }
    .muted{ color: var(--muted); }
    button{
      border:1px solid rgba(96,165,250,.35);
      background: rgba(96,165,250,.16);
      color: var(--text);
      padding:9px 12px;
      border-radius: 12px;
      font-weight: 800;
      cursor:pointer;
      transition:.15s;
    }
    button:hover{ filter: brightness(1.08); }
    button.secondary{
      border-color: rgba(148,163,184,.25);
      background: rgba(148,163,184,.10);
      color: var(--text);
    }
    button.danger{
      border-color: rgba(248,113,113,.35);
      background: rgba(248,113,113,.14);
    }
    input, select, textarea{
      width:100%;
      background: rgba(15,23,42,.65);
      border:1px solid var(--line);
      color: var(--text);
      padding:9px 10px;
      border-radius: 12px;
      outline:none;
      font-family: var(--sans);
    }
    textarea.mono{ font-family: var(--mono); font-size:12px; line-height:1.4; height:140px; }
    .row-actions{ display:flex; gap:8px; justify-content:flex-end; flex-wrap:wrap; }
    table{ width:100%; border-collapse: collapse; }
    th, td{ border-bottom:1px solid rgba(34,48,74,.7); padding:10px 8px; font-size:13px; vertical-align:top; }
    th{ color: var(--muted); text-align:left; font-weight:800; font-size:12px; }
    tr:hover td{ background: rgba(96,165,250,.04); }
    .kv{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    .kv .k{ color: var(--muted); font-size:12px; }
    .okmsg{ color: var(--ok); font-size:12px; margin-top:8px; }
    .err{ color: var(--bad); font-size:12px; white-space:pre-wrap; margin-top:8px; }
    .badge{
      display:inline-flex; align-items:center; gap:6px;
      padding:3px 10px; border-radius:999px;
      border:1px solid var(--line);
      background: rgba(15,23,42,.55);
      font-size:12px; color: var(--muted);
    }
    .badge .dot{ width:8px; height:8px; border-radius:99px; background: var(--muted); }
    .badge.ok .dot{ background: var(--ok); }
    .badge.bad .dot{ background: var(--bad); }
    .badge.warn .dot{ background: var(--warn); }
    .modal-backdrop{
      position:fixed; inset:0; background: rgba(0,0,0,.55);
      display:none; align-items:center; justify-content:center;
      z-index: 50;
      padding:18px;
    }
    .modal{
      width:min(980px, 100%);
      background: rgba(17,26,46,.95);
      border:1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow);
      overflow:hidden;
    }
    .modal .hd{
      padding:14px 16px;
      border-bottom:1px solid var(--line);
      display:flex; justify-content:space-between; align-items:center; gap:10px;
    }
    .modal .hd b{ font-size:14px; }
    .modal .bd{ padding:14px 16px; max-height: 72vh; overflow:auto; }
    .modal .ft{
      padding:12px 16px;
      border-top:1px solid var(--line);
      display:flex; justify-content:flex-end; gap:10px;
    }
    .grid{
      display:grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap:10px 10px;
      margin-top: 10px;
    }
    @media (max-width: 760px){ .grid{ grid-template-columns: 1fr; } }
    .field label{
      display:block;
      font-size:12px;
      color: var(--muted);
      margin-bottom: 6px;
      font-weight:800;
    }
    .group-hd{
      margin-top:16px;
      padding-top:14px;
      border-top:1px solid rgba(34,48,74,.7);
    }
    .box{
      border:1px solid rgba(34,48,74,.8);
      border-radius: 14px;
      padding:12px 12px;
      background: rgba(15,23,42,.35);
    }
    .right{ text-align:right; }
  </style>
</head>
<body>
<header>
  <div class="top">
    <div>
      <h1>AutoBot Admin</h1>
      <div class="sub">FastAPI + PostgreSQL (local) · 브로커 공통 코어 + 브로커별 어댑터(OKX/키움/한투)</div>
    </div>
    <div class="kv">
      <span class="badge" id="healthBadge"><span class="dot"></span><span id="healthText">health: -</span></span>
      <button class="secondary" onclick="reloadHome()">새로고침</button>
    </div>
  </div>

  <div class="tabs">
    <div class="tab active" id="tab-home" onclick="showTab('home')">🏠 홈</div>
    <div class="tab" id="tab-accounts" onclick="showTab('accounts')">👤 계정</div>
    <div class="tab" id="tab-strategies" onclick="showTab('strategies')">🧠 전략</div>
    <div class="tab" id="tab-assets" onclick="showTab('assets')">📦 자산</div>
  </div>
</header>

<div class="wrap">
  <div id="panel-home" class="grid2">
    <div class="card">
      <div class="hd"><b>전광판 (Home)</b><span class="hint">active/last_signal/last_order 등 표시</span></div>
      <div class="bd">
        <div class="hint" id="homeMsg"></div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>계정</th>
              <th>전략</th>
              <th>심볼</th>
              <th>시장</th>
              <th>활성</th>
              <th>last_signal</th>
              <th>last_order</th>
            </tr>
          </thead>
          <tbody id="homeTb"></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="hd"><b>상태</b><span class="hint">서버/DB</span></div>
      <div class="bd">
        <div class="box">
          <div class="kv">
            <span class="k">Server</span><span id="serverInfo" class="mono muted">-</span>
          </div>
          <div class="kv" style="margin-top:10px;">
            <span class="k">DB</span><span id="dbInfo" class="mono muted">-</span>
          </div>
        </div>

        <div class="box" style="margin-top:12px;">
          <b>Week2 Input Sync</b>
          <div class="hint" style="margin-top:8px;">
            전략 → 설정 → signal_params 자동 폼 렌더링 → config 저장 → config_hash 생성 → TradingView 템플릿 출력
          </div>
        </div>

        <div class="box" style="margin-top:12px;">
          <b>Week3~ 멀티 브로커 확장</b>
          <div class="hint" style="margin-top:8px;">
            공통 코어(webhook_events/order_requests 저장) + 주문엔진 코어 + 브로커 어댑터(OKX/키움/한투)
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="panel-accounts" style="display:none;">
    <div class="card">
      <div class="hd">
        <b>Accounts</b>
        <div class="row-actions">
          <button onclick="openModal('account','create')">+ 추가</button>
        </div>
      </div>
      <div class="bd">
        <div class="hint" id="accountsMsg"></div>
        <table>
          <thead>
            <tr>
              <th>ID</th><th>name</th><th>exchange</th><th>active</th><th>last_health</th><th>actions</th>
            </tr>
          </thead>
          <tbody id="accountsTb"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="panel-strategies" style="display:none;">
    <div class="card">
      <div class="hd">
        <b>Strategies</b>
        <div class="row-actions">
          <button onclick="openModal('strategy','create')">+ 추가</button>
        </div>
      </div>
      <div class="bd">
        <div class="hint" id="strategiesMsg"></div>
        <table>
          <thead>
            <tr>
              <th>ID</th><th>name</th><th>active</th><th>params</th><th>updated</th><th>actions</th>
            </tr>
          </thead>
          <tbody id="strategiesTb"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="panel-assets" style="display:none;">
    <div class="card">
      <div class="hd">
        <b>Assets</b>
        <div class="row-actions">
          <button onclick="openModal('asset','create')">+ 추가</button>
        </div>
      </div>
      <div class="bd">
        <div class="hint" id="assetsMsg"></div>
        <table>
          <thead>
            <tr>
              <th>ID</th><th>account</th><th>strategy</th><th>symbol</th><th>market</th><th>active</th><th>actions</th>
            </tr>
          </thead>
          <tbody id="assetsTb"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal-backdrop" id="modal-backdrop">
  <div class="modal">
    <div class="hd">
      <b id="modal-title">Modal</b>
      <button class="secondary" onclick="closeModal()">닫기</button>
    </div>
    <div class="bd" id="modal-body"></div>
    <div class="ft" id="modal-footer"></div>
  </div>
</div>

<script>
  const state = {
    tab: "home",
    accounts: [],
    strategies: [],
    assets: [],
    modal: null,
    onlyRequired: undefined, // strategy_config 필수만 보기 토글 상태
  };

  function showTab(tab){
    state.tab = tab;
    for(const id of ["home","accounts","strategies","assets"]){
      document.getElementById("panel-"+id).style.display = (id===tab) ? "" : "none";
      document.getElementById("tab-"+id).classList.toggle("active", id===tab);
    }
    if(tab==="home") reloadHome();
    if(tab==="accounts") reloadAccounts();
    if(tab==="strategies") reloadStrategies();
    if(tab==="assets") reloadAssets();
  }

  async function api(url, opts={}){
    const res = await fetch(url, {
      headers: { "Content-Type":"application/json", ...(opts.headers||{}) },
      ...opts
    });
    const text = await res.text();
    let data = null;
    try { data = text ? JSON.parse(text) : null; } catch(e){ data = text; }
    if(!res.ok){
      const msg = (data && data.detail) ? data.detail : (typeof data==="string" ? data : JSON.stringify(data));
      throw new Error(`${res.status} ${res.statusText} :: ${msg}`);
    }
    return data;
  }

  function setMsg(which, msg=""){
    const el = document.getElementById(which+"Msg");
    if(el) el.textContent = msg || "";
  }

  function escapeHtml(s){
    return String(s??"")
      .replaceAll("&","&amp;")
      .replaceAll("<","&lt;")
      .replaceAll(">","&gt;")
      .replaceAll('"',"&quot;")
      .replaceAll("'","&#039;");
  }
  function escapeAttr(s){ return escapeHtml(s); }

  function closeModal(){
    document.getElementById("modal-backdrop").style.display = "none";
    state.modal = null;
  }

  // ---------------- Home ----------------
  async function reloadHome(){
    setMsg("home");
    try{
      const health = await api("/health");
      const hb = document.getElementById("healthBadge");
      const ht = document.getElementById("healthText");
      hb.classList.remove("ok","bad","warn");
      hb.classList.add(health.ok ? "ok":"bad");
      ht.textContent = `health: ${health.ok ? "ok":"fail"}`;

      const db = await api("/db-check");
      document.getElementById("serverInfo").textContent = `${health.app} @ ${health.time}`;
      document.getElementById("dbInfo").textContent = JSON.stringify(db, null, 2);

      const rows = await api("/api/home");
      const tb = document.getElementById("homeTb");
      tb.innerHTML = "";
      for(const r of rows.items || []){
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td>${r.id}</td>
          <td>${escapeHtml(r.account_name||"-")}</td>
          <td>${escapeHtml(r.strategy_name||"-")}</td>
          <td class="mono">${escapeHtml(r.symbol||"-")}</td>
          <td>${escapeHtml(r.market||"-")}</td>
          <td>${r.is_active ? "✅" : "—"}</td>
          <td class="mono">${escapeHtml(r.last_signal||"-")}</td>
          <td class="mono">${escapeHtml(r.last_order||"-")}</td>
        `;
        tb.appendChild(tr);
      }
    }catch(e){
      document.getElementById("homeMsg").textContent = e.message;
    }
  }

  // ---------------- Accounts ----------------
  async function reloadAccounts(){
    setMsg("accounts");
    const rows = await api("/api/accounts");
    state.accounts = rows.items || [];
    const tb = document.getElementById("accountsTb");
    tb.innerHTML = "";
    for(const a of state.accounts){
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${a.id}</td>
        <td>${escapeHtml(a.name)}</td>
        <td>${escapeHtml(a.exchange)}</td>
        <td>${a.is_active ? "✅" : "—"}</td>
        <td class="mono">${escapeHtml(a.last_health_msg || "-")}</td>
        <td class="right">
          <div class="row-actions">
            <button class="secondary" onclick="toggleAccount(${a.id}, ${a.is_active ? "false":"true"})">${a.is_active?"비활성":"활성"}</button>
            <button class="secondary" onclick="openModal('account','edit', ${a.id})">수정</button>
            <button class="danger" onclick="deleteAccount(${a.id})">삭제</button>
          </div>
        </td>
      `;
      tb.appendChild(tr);
    }
  }
  async function toggleAccount(id, on){
    await api(`/api/accounts/${id}`, { method:"PUT", body: JSON.stringify({ is_active:on }) });
    reloadAccounts(); reloadHome();
  }
  async function deleteAccount(id){
    if(!confirm("삭제할까요? (참조가 있으면 soft delete 됩니다)")) return;
    setMsg("accounts");
    await api(`/api/accounts/${id}`, { method:"DELETE" });
    reloadAccounts(); reloadHome();
    setMsg("accounts","삭제 완료");
  }

  // ---------------- Strategies ----------------
  async function reloadStrategies(){
    setMsg("strategies");
    const rows = await api("/api/strategies");
    state.strategies = rows.items || [];
    const tb = document.getElementById("strategiesTb");
    tb.innerHTML = "";
    for(const s of state.strategies){
      let pcount = "-";
      try{
        const pr = await api(`/api/strategies/${s.id}/signal-params`);
        const arr = Array.isArray(pr) ? pr : (pr.items || pr.params || []);
        pcount = (arr && arr.length !== undefined) ? arr.length : "-";
      }catch(e){ pcount = "0"; }

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${s.id}</td>
        <td>${escapeHtml(s.name)}</td>
        <td>${s.is_active ? "✅" : "—"}</td>
        <td class="mono">${pcount}</td>
        <td class="mono">${escapeHtml(s.updated_at || "-")}</td>
        <td class="right">
          <div class="row-actions">
            <button class="secondary" onclick="toggleStrategy(${s.id}, ${s.is_active ? "false":"true"})">${s.is_active?"비활성":"활성"}</button>
            <button class="secondary" onclick="openModal('strategy','edit', ${s.id})">수정</button>
            <button class="secondary" onclick="openStrategyConfig(${s.id})">설정</button>
            <button class="danger" onclick="deleteStrategy(${s.id})">삭제</button>
          </div>
        </td>
      `;
      tb.appendChild(tr);
    }
  }
  async function toggleStrategy(id, on){
    await api(`/api/strategies/${id}`, { method:"PUT", body: JSON.stringify({ is_active:on }) });
    reloadStrategies(); reloadHome();
  }
  async function deleteStrategy(id){
    if(!confirm("삭제할까요? (참조가 있으면 soft delete 됩니다)")) return;
    setMsg("strategies");
    await api(`/api/strategies/${id}`, { method:"DELETE" });
    reloadStrategies(); reloadHome();
    setMsg("strategies","삭제 완료");
  }

  // ---------------- Assets ----------------
  async function reloadAssets(){
    setMsg("assets");
    const rows = await api("/api/assets");
    state.assets = rows.items || [];
    const tb = document.getElementById("assetsTb");
    tb.innerHTML = "";
    for(const a of state.assets){
      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${a.id}</td>
        <td>${escapeHtml(a.account_name||"-")}</td>
        <td>${escapeHtml(a.strategy_name||"-")}</td>
        <td class="mono">${escapeHtml(a.symbol||"-")}</td>
        <td>${escapeHtml(a.market||"-")}</td>
        <td>${a.is_active ? "✅" : "—"}</td>
        <td class="right">
          <div class="row-actions">
            <button class="secondary" onclick="openModal('asset','edit', ${a.id})">수정</button>
            <button class="danger" onclick="deleteAsset(${a.id})">삭제</button>
          </div>
        </td>
      `;
      tb.appendChild(tr);
    }
  }
  async function deleteAsset(id){
    if(!confirm("삭제할까요? (참조가 있으면 soft delete 됩니다)")) return;
    setMsg("assets");
    await api(`/api/assets/${id}`, { method:"DELETE" });
    reloadAssets(); reloadHome();
    setMsg("assets","삭제 완료");
  }

  // ---------------- Modal: CRUD ----------------
  function openModal(kind, mode, id=null){
    state.modal = { kind, mode, item: null };

    if(kind === "account"){
      state.modal.item = (mode==="edit")
        ? state.accounts.find(x=>x.id===id)
        : { name:"", exchange:"OKX", api_key:"", api_secret:"", api_passphrase:"", is_active:false };
      renderAccountModal();
    }

    if(kind === "strategy"){
      state.modal.item = (mode==="edit")
        ? state.strategies.find(x=>x.id===id)
        : { name:"", tv_secret:"", is_active:false };
      renderStrategyModal();
    }

    if(kind === "asset"){
      state.modal.item = (mode==="edit")
        ? state.assets.find(x=>x.id===id)
        : { account_id: null, strategy_id: null, symbol:"", market:"SPOT", is_active:true };
      renderAssetModal();
    }

    document.getElementById("modal-backdrop").style.display = "flex";
  }

  function renderAccountModal(){
    const item = state.modal.item;
    document.getElementById("modal-title").textContent = state.modal.mode==="create" ? "Account 추가" : `Account 수정 (ID ${item.id})`;
    document.getElementById("modal-body").innerHTML = `
      <div class="grid">
        <div class="field"><label>name</label><input id="f_name" value="${escapeAttr(item.name||"")}" /></div>
        <div class="field"><label>exchange</label>
          <select id="f_exchange">
            <option ${item.exchange==="OKX"?"selected":""}>OKX</option>
            <option ${item.exchange==="KIWOOM"?"selected":""}>KIWOOM</option>
            <option ${item.exchange==="KIS"?"selected":""}>KIS</option>
          </select>
        </div>
        <div class="field"><label>api_key</label><input id="f_api_key" value="${escapeAttr(item.api_key||"")}" /></div>
        <div class="field"><label>api_secret</label><input id="f_api_secret" value="${escapeAttr(item.api_secret||"")}" /></div>
        <div class="field"><label>api_passphrase</label><input id="f_api_passphrase" value="${escapeAttr(item.api_passphrase||"")}" /></div>
        <div class="field"><label>is_active</label>
          <select id="f_is_active">
            <option value="false" ${item.is_active? "":"selected"}>false</option>
            <option value="true" ${item.is_active? "selected":""}>true</option>
          </select>
