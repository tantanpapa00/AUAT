  // 3) 저장(config 생성) → 결과(config_id/config_hash/reused) 표시
  // 4) 저장 직후 TradingView 템플릿 2종 자동 출력 + 복사
  // 5) 파라미터 0이면 "먼저 sync 필요" + (선택) UI에서 Parse+Sync 버튼 제공

  function isRequiredGroup(groupName){
    const g = String(groupName||"").toLowerCase().trim();
    if(g.startsWith("99.")) return true;
    if(g.includes("webhook") || g.includes("alert")) return true;
    return false;
  }

  function filterParamsByRequired(params, onlyRequired){
    if(!onlyRequired) return params;
    return params.filter(p => isRequiredGroup(p.group_name));
  }

  async function openStrategyConfig(strategyId){
    state.modal = { kind:"strategy_config", mode:"edit", item:{ strategyId } };
    document.getElementById("modal-backdrop").style.display = "flex";
