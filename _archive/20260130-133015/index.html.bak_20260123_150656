    document.getElementById("modal-body").innerHTML = `<div class="hint">signal_params 불러오는 중...</div>`;
    document.getElementById("modal-footer").innerHTML = `
      <button class="secondary" onclick="closeModal()">닫기</button>
    `;

    try{
      const paramsRaw = await api(`/api/strategies/${strategyId}/signal-params`);
      const params = normalizeSignalParams(paramsRaw);
      __lastParams = params;

      if(params.length === 0){
        renderStrategyConfigEmptyModal(strategyId);
        return;
      }
      renderStrategyConfigModal(strategyId, paramsRaw);
    }catch(e){
      document.getElementById("modal-body").innerHTML = `
        <div class="err">signal_params 로드 실패:\n${escapeHtml(e.message)}</div>
        <div class="hint" style="margin-top:10px;">
          체크: GET /api/strategies/${strategyId}/signal-params 가 존재해야 합니다.
        </div>
      `;
      document.getElementById("modal-footer").innerHTML = `
        <button class="secondary" onclick="closeModal()">닫기</button>
      `;
    }
  }

  function normalizeSignalParams(rows){
    const arr = Array.isArray(rows) ? rows : (rows && rows.items ? rows.items : []);
    return arr
      .filter(x => !x.is_hidden)
      .sort((a,b)=>{
        const ga = (a.group_name||"").toLowerCase();
        const gb = (b.group_name||"").toLowerCase();
        if(ga<gb) return -1; if(ga>gb) return 1;
        const oa = a.order_index ?? 0;
        const ob = b.order_index ?? 0;
        if(oa!==ob) return oa-ob;
        return String(a.key).localeCompare(String(b.key));
      });
  }

  function renderStrategyConfigEmptyModal(strategyId){
    document.getElementById("modal-body").innerHTML = `
      <div class="box">
        <div class="kv">
          <span class="k">전략 ID</span><b class="mono">${strategyId}</b>
          <span class="k">파라미터 수</span><b>0</b>
        </div>
        <div class="err" style="margin-top:10px;">
          이 전략에는 signal_params가 없습니다. 먼저 <b>sync</b>가 필요합니다.
        </div>
        <div class="hint" style="margin-top:10px;">
          ✅ 가장 쉬운 방법(권장): 기존에 성공했던 PowerShell 커맨드 재사용<br/>
          - POST /api/pine/parse-inputs → inputs.json 생성<br/>
          - POST /api/strategies/${strategyId}/signal-params:sync
        </div>
      </div>

      <div class="box" style="margin-top:14px;">
        <b>선택: UI에서 바로 Parse + Sync</b>
        <div class="hint" style="margin-top:6px;">
          TradingView PineScript 전체 코드를 아래에 붙여넣고 실행하세요.
        </div>
        <textarea id="pine_code" class="mono" style="height:180px;" placeholder="//@version=5 ... 전체 Pine 코드"></textarea>
        <div class="kv" style="margin-top:10px; justify-content:flex-end;">
          <button class="secondary" onclick="parseAndSync(${strategyId})">Parse + Sync</button>
        </div>
        <div id="sync_status" class="mono muted" style="margin-top:8px;">-</div>
      </div>
    `;

    document.getElementById("modal-footer").innerHTML = `
      <button class="secondary" onclick="closeModal()">닫기</button>
    `;
  }

  async function parseAndSync(strategyId){
    const st = document.getElementById("sync_status");
    st.textContent = "Parsing...";
    try{
      const code = (document.getElementById("pine_code").value || "").trim();
      if(!code) throw new Error("Pine 코드가 비었습니다. PineScript 전체를 붙여넣어 주세요.");

      const parsed = await api("/api/pine/parse-inputs", {
        method:"POST",
        body: JSON.stringify({ code })
      });

      if(!parsed || !parsed.ok) throw new Error("parse-inputs 실패: 응답이 비정상입니다.");
      st.textContent = `Parsed OK: count=${parsed.count} → syncing...`;

      const syncRes = await api(`/api/strategies/${strategyId}/signal-params:sync`, {
        method:"POST",
        body: JSON.stringify({ inputs: parsed.inputs })
      });

      st.textContent = `Sync OK: received=${syncRes.received}, upserted=${syncRes.upserted}. 다시 불러오는 중...`;

      const paramsRaw = await api(`/api/strategies/${strategyId}/signal-params`);
      const params = normalizeSignalParams(paramsRaw);
      __lastParams = params;
      renderStrategyConfigModal(strategyId, paramsRaw);
    }catch(e){
      st.textContent = `ERROR: ${e.message}`;
    }
  }

  function renderStrategyConfigModal(strategyId, rows){
    const paramsAll = normalizeSignalParams(rows);
    __lastParams = paramsAll;

    if(state.onlyRequired === undefined) state.onlyRequired = true;
    const params = filterParamsByRequired(paramsAll, state.onlyRequired);

    const byGroup = new Map();
    for(const p of params){
      const g = p.group_name || "General";
      if(!byGroup.has(g)) byGroup.set(g, []);
      byGroup.get(g).push(p);
    }

    let html = `
      <div class="box">
        <div class="kv" style="flex-wrap:wrap;">
          <span class="k">전략 ID</span><b class="mono">${strategyId}</b>
          <span class="k">파라미터</span><b>${params.length}</b>
          <span class="k">전체</span><b class="muted">${paramsAll.length}</b>

          <span class="k">config name</span>
          <input id="cfg_name" style="width:260px;" value="ui-${new Date().toISOString().slice(0,19)}" />

          <label class="pill ${state.onlyRequired?'on':'off'}" style="cursor:pointer;">
            <input id="only_required" type="checkbox" ${state.onlyRequired?'checked':''}
                   onchange="toggleRequired(${strategyId})" style="margin-right:6px;" />
            필수만 보기(99.*)
          </label>

          <button class="secondary" onclick="fillDefaults()">기본값으로 리셋</button>
        </div>
        <div class="hint" style="margin-top:8px;">
          저장하면 strategy_configs에 config가 쌓이고, 바로 TradingView 템플릿 2종(해시 포함/미포함)을 생성합니다.
          (필수만 보기 ON이면 화면은 99.* 그룹만 보이지만, 저장은 전체 key를 포함합니다. 보이지 않는 값은 defval로 저장됩니다.)
        </div>
      </div>
    `;

    for(const [g, items] of byGroup.entries()){
      html += `<div class="group-hd"><b>${escapeHtml(g)}</b></div>`;
      html += `<div class="grid">`;
      for(const p of items){
        html += renderParamField(p);
      }
      html += `</div>`;
    }

    html += `
      <div style="margin-top:14px;" class="box">
        <div class="kv">
          <span class="k">저장 결과</span>
          <span id="cfg_result" class="mono muted">-</span>
          <button class="secondary" onclick="copyText('cfg_result')">복사</button>
        </div>
        <div class="err" id="cfg_err"></div>
        <div class="okmsg" id="cfg_ok"></div>
      </div>

      <div style="margin-top:14px;" class="box">
        <div class="kv" style="justify-content:space-between;">
          <div><b>TradingView Template (include_hash=true)</b></div>
          <div class="kv">
            <button class="secondary" onclick="copyText('tv_with_hash')">복사</button>
          </div>
        </div>
        <textarea id="tv_with_hash" class="mono" readonly></textarea>
      </div>

      <div style="margin-top:14px;" class="box">
        <div class="kv" style="justify-content:space-between;">
          <div><b>TradingView Template (include_hash=false)</b></div>
          <div class="kv">
            <button class="secondary" onclick="copyText('tv_no_hash')">복사</button>
          </div>
        </div>
        <textarea id="tv_no_hash" class="mono" readonly></textarea>
      </div>
    `;

    document.getElementById("modal-body").innerHTML = html;

    document.getElementById("modal-footer").innerHTML = `
      <button class="secondary" onclick="closeModal()">닫기</button>
      <button onclick="saveStrategyConfig(${strategyId})">저장(config 생성)</button>
    `;

    applyDefvalsFromParams();
  }

  function toggleRequired(strategyId){
    const chk = document.getElementById("only_required");
    state.onlyRequired = !!(chk && chk.checked);
    renderStrategyConfigModal(strategyId, __lastParams);
  }

  function fillDefaults(){
    applyDefvalsFromParams();
    document.getElementById("cfg_err") && (document.getElementById("cfg_err").textContent = "");
    document.getElementById("cfg_ok")  && (document.getElementById("cfg_ok").textContent  = "");
  }

  function renderParamField(p){
    const key = String(p.key || "");
    const title = p.title || key;
    const type = (p.type || "string").toLowerCase();
    const tooltip = p.tooltip ? `<div class="hint">${escapeHtml(p.tooltip)}</div>` : "";
    const id = `p_${key.replaceAll(".","_").replaceAll("-","_")}`;

    const options = p.options;

    if(Array.isArray(options) && options.length){
      const opts = options.map(o => {
        const ov = String(o);
        return `<option value="${escapeAttr(ov)}">${escapeHtml(ov)}</option>`;
      }).join("");
      return `
        <div class="field">
          <label>${escapeHtml(title)} <span class="hint mono">(${escapeHtml(key)})</span></label>
          <select id="${escapeAttr(id)}" data-key="${escapeAttr(key)}" data-type="string">${opts}</select>
          ${tooltip}
        </div>
      `;
    }

    if(type === "bool" || type === "boolean"){
      return `
        <div class="field">
          <label>${escapeHtml(title)} <span class="hint mono">(${escapeHtml(key)})</span></label>
          <select id="${escapeAttr(id)}" data-key="${escapeAttr(key)}" data-type="bool">
            <option value="false">false</option>
            <option value="true">true</option>
          </select>
          ${tooltip}
        </div>
      `;
    }

    if(type === "int" || type === "integer" || type === "float" || type === "number"){
      const min = (p.min_val ?? "");
      const max = (p.max_val ?? "");
      const step = (p.step_val ?? (type === "int" ? 1 : 0.01));
      return `
        <div class="field">
          <label>${escapeHtml(title)} <span class="hint mono">(${escapeHtml(key)})</span></label>
          <input id="${escapeAttr(id)}" data-key="${escapeAttr(key)}" data-type="${escapeAttr(type)}"
                 type="number" step="${escapeAttr(step)}" ${min!==""?`min="${escapeAttr(min)}"`:""} ${max!==""?`max="${escapeAttr(max)}"`:""} />
          ${tooltip}
        </div>
      `;
    }

    return `
      <div class="field">
        <label>${escapeHtml(title)} <span class="hint mono">(${escapeHtml(key)})</span></label>
        <input id="${escapeAttr(id)}" data-key="${escapeAttr(key)}" data-type="string" type="text" />
        ${tooltip}
      </div>
    `;
  }

  let __lastParams = [];
  function applyDefvalsFromParams(){
    if(!__lastParams.length) return;
    for(const p of __lastParams){
      if(p.is_hidden) continue;
      const key = String(p.key||"");
      const id = `p_${key.replaceAll(".","_").replaceAll("-","_")}`;
      const el = document.getElementById(id);
      if(!el) continue;

      const t = (p.type||"string").toLowerCase();
      const v = p.defval;

      if(t === "bool" || t === "boolean"){
        el.value = (v === true) ? "true" : "false";
      }else if(t === "int" || t === "integer" || t === "float" || t === "number"){
        el.value = (v === null || v === undefined) ? "" : String(v);
      }else{
        el.value = (v === null || v === undefined) ? "" : String(v);
      }

      if(el.tagName === "SELECT" && Array.isArray(p.options) && p.options.length){
        const sv = (v === null || v === undefined) ? "" : String(v);
        if(sv) el.value = sv;
      }
    }
  }

  async function saveStrategyConfig(strategyId){
    document.getElementById("cfg_err").textContent = "";
    document.getElementById("cfg_ok").textContent = "";
    document.getElementById("cfg_result").textContent = "-";
    document.getElementById("tv_with_hash").value = "";
    document.getElementById("tv_no_hash").value = "";

    try{
      const paramsRaw = await api(`/api/strategies/${strategyId}/signal-params`);
      const params = normalizeSignalParams(paramsRaw);
      __lastParams = params;

      const values = {};
      for(const p of params){
        values[p.key] = p.defval;
      }

      const fields = document.querySelectorAll("[data-key][data-type]");
      for(const el of fields){
        const key = el.getAttribute("data-key");
        const type = el.getAttribute("data-type");

        let raw = el.value;
        if(type === "bool" || type === "boolean"){
          values[key] = (raw === "true");
        }else if(type === "int" || type === "integer"){
          values[key] = (raw === "" ? null : Number.parseInt(raw, 10));
        }else if(type === "float" || type === "number"){
          values[key] = (raw === "" ? null : Number.parseFloat(raw));
        }else{
          values[key] = raw;
        }
      }

      const name = (document.getElementById("cfg_name").value || "ui").trim();

      const body = { name, values, is_active: true };
      const saved = await api(`/api/strategies/${strategyId}/configs`, { method:"POST", body: JSON.stringify(body) });

      const configId = saved.config_id ?? saved.id ?? null;
      const cfgHash  = saved.config_hash ?? saved.hash ?? null;
      const reused   = (saved.reused === true);

      document.getElementById("cfg_result").textContent = `config_id=${configId} | config_hash=${cfgHash} | reused=${reused}`;

      const t1 = await api(`/api/strategies/${strategyId}/templates/tradingview?config_id=${configId}&include_hash=true`);
      const t2 = await api(`/api/strategies/${strategyId}/templates/tradingview?config_id=${configId}&include_hash=false`);

      document.getElementById("tv_with_hash").value = JSON.stringify(t1.template, null, 2);
      document.getElementById("tv_no_hash").value  = JSON.stringify(t2.template, null, 2);

      document.getElementById("cfg_ok").textContent = "저장 + 템플릿 생성 완료";
    }catch(e){
      document.getElementById("cfg_err").textContent = e.message;
    }
  }

  async function copyText(id){
    const el = document.getElementById(id);
    if(!el) return;
    const text = (el.tagName === "TEXTAREA" || el.tagName === "INPUT") ? el.value : el.textContent;
    try{
      await navigator.clipboard.writeText(text || "");
    }catch(e){
      const ta = document.createElement("textarea");
      ta.value = text || "";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }
  }

  // 초기 로드
  (async ()=>{
    await reloadHome();
    await reloadAccounts();
    await reloadStrategies();
    await reloadAssets();
  })();
</script>

