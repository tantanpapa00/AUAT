# ---- OKX broker (only if missing) ----
if "okx_place_order" not in globals():
    import json as _json
    import time as _time
    import base64 as _base64
    import hmac as _hmac
    from datetime import datetime as _dt

    try:
        import requests as _requests
    except Exception as _e:
        _requests = None

    def _okx_env():
        # supports both OKX_API_* and legacy OKX_* names
        base = os.getenv("OKX_BASE_URL") or "https://www.okx.com"
        key  = os.getenv("OKX_API_KEY") or os.getenv("OKX_KEY") or ""
        sec  = os.getenv("OKX_API_SECRET") or os.getenv("OKX_SECRET") or ""
        pas  = os.getenv("OKX_API_PASSPHRASE") or os.getenv("OKX_PASSPHRASE") or ""
        sim  = (os.getenv("OKX_SIMULATED") or "0").strip()
        timeout = float(os.getenv("OKX_TIMEOUT", "10") or "10")
        if not key or not sec or not pas:
            raise RuntimeError("okx_env_missing: need OKX_API_KEY/OKX_API_SECRET/OKX_API_PASSPHRASE (or OKX_KEY/OKX_SECRET/OKX_PASSPHRASE)")
        return base, key, sec, pas, sim, timeout

    def _okx_ts() -> str:
        return _dt.utcnow().isoformat(timespec="milliseconds") + "Z"

    def _okx_sign(secret: str, prehash: str) -> str:
        mac = _hmac.new(secret.encode("utf-8"), prehash.encode("utf-8"), digestmod="sha256").digest()
        return _base64.b64encode(mac).decode("utf-8")

    def _okx_headers(ts: str, sign: str, *, key: str, pas: str, sim: str):
        headers = {
            "Content-Type": "application/json",
            "OK-ACCESS-KEY": key,
            "OK-ACCESS-SIGN": sign,
            "OK-ACCESS-TIMESTAMP": ts,
            "OK-ACCESS-PASSPHRASE": pas,
        }
        if sim == "1":
            headers["x-simulated-trading"] = "1"
        return headers

    def okx_place_order(*, symbol: str, side: str, qty: float, order_type: str = "market", payload: dict | None = None) -> dict:
        if _requests is None:
            raise RuntimeError("requests_missing: install requests")

        base, key, sec, pas, sim, timeout = _okx_env()

        path = "/api/v5/trade/order"
        url = base + path

        ord_type = (order_type or "market").lower()
        if ord_type not in ("market", "limit"):
            ord_type = "market"

        body = {
            "instId": symbol,
            "tdMode": "cash",
            "side": side,
            "ordType": ord_type,
            "sz": str(qty),
        }

        # Spot market BUY: set tgtCcy=base_ccy so sz is base amount
        if side.lower() == "buy" and ord_type == "market":
            body["tgtCcy"] = "base_ccy"

        if ord_type == "limit":
            px = None
            if isinstance(payload, dict):
                px = payload.get("price") or payload.get("px")
            if px is None:
                raise RuntimeError("limit_requires_price")
            body["px"] = str(px)

        body_json = _json.dumps(body, separators=(",", ":"), ensure_ascii=False)
        ts = _okx_ts()
        prehash = f"{ts}POST{path}{body_json}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        # utf-8 encode to avoid latin-1 issue
        resp = _requests.post(url, headers=headers, data=body_json.encode("utf-8"), timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")

        data = resp.json()
        if str(data.get("code")) != "0":
            raise RuntimeError(f"okx_error code={data.get('code')} msg={data.get('msg')} data={data.get('data')}")
        return data

    def okx_get_order(*, symbol: str, okx_order_id: str) -> dict:
        if _requests is None:
            raise RuntimeError("requests_missing: install requests")

        base, key, sec, pas, sim, timeout = _okx_env()
        path = "/api/v5/trade/order"
        query = f"instId={symbol}&ordId={okx_order_id}"
        url = base + path + "?" + query

        ts = _okx_ts()
        prehash = f"{ts}GET{path}?{query}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        resp = _requests.get(url, headers=headers, timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")

        data = resp.json()
        if str(data.get("code")) != "0":
            raise RuntimeError(f"okx_error code={data.get('code')} msg={data.get('msg')} data={data.get('data')}")
        return data


