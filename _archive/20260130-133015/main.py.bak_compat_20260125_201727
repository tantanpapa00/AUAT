    except Exception:
        return default

def okx_get_balances(*, ttl_sec: int = 10) -> dict:
    """Return OKX balance payload with TTL cache."""
    import time
    now = time.time()
    try:
        if _okx_bal_cache["data"] is not None and (now - float(_okx_bal_cache["ts"])) < ttl_sec:
            return {"ok": True, "data": _okx_bal_cache["data"], "msg": "cached"}

        base, key, sec, pas, sim, timeout = _okx_env()
        path = "/api/v5/account/balance"
        url = base + path
        ts = _okx_ts()
        prehash = f"{ts}GET{path}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        resp = _requests.get(url, headers=headers, timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")
        j = resp.json()
        if str(j.get("code")) != "0":
            raise RuntimeError(f"okx_error code={j.get('code')} msg={j.get('msg')} data={j.get('data')}")

        _okx_bal_cache.update({"ts": now, "data": j, "msg": "ok"})
        return {"ok": True, "data": j, "msg": "ok"}
    except Exception as e:
        _okx_bal_cache.update({"ts": now, "data": None, "msg": str(e)})
        return {"ok": False, "data": None, "msg": str(e)}

def okx_avail_ccy(ccy: str) -> float:
    """Extract available balance(=availBal) for currency."""
    res = okx_get_balances(ttl_sec=int(os.getenv("OKX_BAL_TTL", "10") or "10"))
    if not res.get("ok"):
        return 0.0
    j = res.get("data") or {}
    # OKX format: data[0].details[*].ccy, .availBal
    try:
        data = (j.get("data") or [])
        if not data:
            return 0.0
        details = (data[0].get("details") or [])
        ccy_u = (ccy or "").upper()
        for d in details:
            if (d.get("ccy") or "").upper() == ccy_u:
                return float(d.get("availBal") or 0.0)
    except Exception:
        pass
    return 0.0

def okx_last_price(instId: str, *, ttl_sec: int = 10) -> float | None:
    """Fetch last price using /api/v5/market/ticker (TTL cache per instId)."""
    import time
    now = time.time()
    k = (instId or "").strip()
    if not k:
        return None
    try:
        hit = _okx_px_cache.get(k)
        if hit and (now - float(hit.get("ts", 0.0))) < ttl_sec:
            return float(hit.get("px"))

        base = os.getenv("OKX_BASE_URL") or "https://www.okx.com"
        url = f"{base}/api/v5/market/ticker?instId={k}"
        resp = _requests.get(url, timeout=float(os.getenv("OKX_TIMEOUT", "10") or "10"))
        if resp.status_code != 200:
            return None
        j = resp.json()
        if str(j.get("code")) != "0":
            return None
        data = j.get("data") or []
        if not data:
            return None
        px = float(data[0].get("last") or 0.0)
        if px <= 0:
            return None
        _okx_px_cache[k] = {"ts": now, "px": px}
        return px
    except Exception:
        return None

def _inst_base_quote(instId: str) -> tuple[str, str]:
    # OKX spot instId pattern: BASE-QUOTE, e.g., BTC-USDT
    s = (instId or "")
    if "-" in s:
        a, b = s.split("-", 1)
        return (a.upper(), b.upper())
    return (s.upper(), "USDT")

def okx_balance_guard(*, symbol: str, side: str, qty: float) -> None:
    """Raise RuntimeError with standardized reason prefix when insufficient."""
    enable = _hotpatch_bool(os.getenv("OKX_BAL_GUARD_ENABLE", "1"), True)
    if not enable:
        return

    side_l = (side or "").lower()
    base_ccy, quote_ccy = _inst_base_quote(symbol)

    # SELL: need base asset qty
    if side_l == "sell":
        have = okx_avail_ccy(base_ccy)
        if have + 1e-12 < float(qty):
            raise RuntimeError(f"INSUFFICIENT_BAL: need {qty} {base_ccy}, have {have} {base_ccy}")
        return

    # BUY: need quote currency approx = qty * last_price (tgtCcy=base_ccy)
    px = okx_last_price(symbol, ttl_sec=int(os.getenv("OKX_PX_TTL", "10") or "10"))
    if px is None:
        # can't estimate safely -> block (safer) or allow (less safe)
        block = _hotpatch_bool(os.getenv("OKX_BLOCK_ON_NO_PRICE", "1"), True)
        if block:
            raise RuntimeError("PRICE_UNAVAILABLE: cannot estimate required quote amount")
        return

    slip = _hotpatch_float(os.getenv("OKX_BAL_GUARD_SLIPPAGE", "0.01"), 0.01)  # 1% default
    need_quote = float(qty) * float(px) * (1.0 + slip)
    have_quote = okx_avail_ccy(quote_ccy)
    if have_quote + 1e-8 < need_quote:
        raise RuntimeError(f"INSUFFICIENT_BAL: need~{need_quote:.6f} {quote_ccy} (qty={qty} px={px}), have {have_quote} {quote_ccy}")

# wrap okx_place_order (balance guard before submit)
if "okx_place_order" in globals() and "_okx_place_order_bal_guard_wrapped" not in globals():
    _okx_place_order_bal_guard_wrapped = True
    _okx_place_order_before_bal_guard = okx_place_order

