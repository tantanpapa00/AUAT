# [HOTPATCH_W3D1_OKX_PREFLIGHT] block submit on OKX env mismatch (50101)
# - cache preflight result (TTL seconds)
# - wrap okx_place_order to enforce preflight before sending
# - reason code: OKX_ENV_MISMATCH / OKX_AUTH_ERROR
# ============================================================

if "_okx_preflight_cache" not in globals():
    _okx_preflight_cache = {"ts": 0.0, "ok": None, "msg": ""}

def okx_preflight(*, ttl_sec: int = 30) -> dict:
    """Check OKX environment/auth quickly. Returns {ok:bool, msg:str} with TTL cache."""
    import time
    now = time.time()
    try:
        if _okx_preflight_cache["ok"] is not None and (now - float(_okx_preflight_cache["ts"])) < ttl_sec:
            return {"ok": bool(_okx_preflight_cache["ok"]), "msg": str(_okx_preflight_cache["msg"])}

        # minimal call that triggers 50101 if environment mismatch
        base, key, sec, pas, sim, timeout = _okx_env()
        path = "/api/v5/account/balance"
        url = base + path

        ts = _okx_ts()
        prehash = f"{ts}GET{path}"
        sign = _okx_sign(sec, prehash)
        headers = _okx_headers(ts, sign, key=key, pas=pas, sim=sim)

        if _requests is None:
            raise RuntimeError("requests_missing")

        resp = _requests.get(url, headers=headers, timeout=timeout)
        if resp.status_code != 200:
            raise RuntimeError(f"okx_http_error status={resp.status_code} body={resp.text}")

        data = resp.json()
        if str(data.get("code")) != "0":
            raise RuntimeError(f"okx_error code={data.get('code')} msg={data.get('msg')} data={data.get('data')}")

        _okx_preflight_cache.update({"ts": now, "ok": True, "msg": "ok"})
        return {"ok": True, "msg": "ok"}

    except Exception as e:
        msg = str(e)
        _okx_preflight_cache.update({"ts": now, "ok": False, "msg": msg})
        return {"ok": False, "msg": msg}

# wrap okx_place_order (enforce preflight)
if "okx_place_order" in globals() and "_okx_place_order_wrapped" not in globals():
    _okx_place_order_wrapped = True
    _okx_place_order_original = okx_place_order

    def okx_place_order(*, symbol: str, side: str, qty: float, order_type: str = "market", payload: dict | None = None) -> dict:
        chk = okx_preflight(ttl_sec=int(os.getenv("OKX_PREFLIGHT_TTL", "30") or "30"))
        if not chk.get("ok", False):
            # normalize reason for 50101
            msg = str(chk.get("msg",""))
            if "50101" in msg or "environment" in msg.lower():
                raise RuntimeError("OKX_ENV_MISMATCH: " + msg)
            raise RuntimeError("OKX_AUTH_ERROR: " + msg)
        return _okx_place_order_original(symbol=symbol, side=side, qty=qty, order_type=order_type, payload=payload)

