        select
            c.id as config_id,
            c.strategy_id,
            c.values as cfg_values,
            c.config_hash,
            s.tv_secret as strategy_secret
        from strategy_configs c
        join strategies s on s.id = c.strategy_id
        where c.config_hash = :h
        order by c.id desc
        limit 1
    """), {"h": config_hash}).mappings().first()
    if not row:
